# openctl Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Clerk Authentication (Required for auth features)
# =============================================================================

# Clerk publishable key (starts with pk_)
# Get this from: Clerk Dashboard > API Keys
# Note: Must use PUBLIC_ prefix for client-side bundling
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key (starts with sk_)
# Get this from: Clerk Dashboard > API Keys
CLERK_SECRET_KEY=sk_test_...

# Clerk Frontend API proxy URL (production only, optional)
# When set, the app proxies Clerk's Frontend API through our own domain at
# /__clerk/* instead of using a CNAME record. Used both client-side
# (ClerkProvider proxyUrl) and server-side (Clerk-Proxy-Url header), so it must
# exactly match the proxy URL configured in the Clerk Dashboard (Domains >
# Frontend API > proxy configuration). PUBLIC_ prefix required for client bundling.
# Docs: https://clerk.com/docs/guides/dashboard/dns-domains/proxy-fapi
# PUBLIC_CLERK_PROXY_URL=https://openctl.dev/__clerk

# Override the upstream Clerk Frontend API host (optional)
# Defaults to Clerk's shared production endpoint; rarely needs changing.
# CLERK_FAPI_URL=https://frontend-api.clerk.dev

# =============================================================================
# CLI OAuth Configuration (Required for CLI auth)
# =============================================================================

# OAuth client ID for CLI authentication
# Configure in: Clerk Dashboard > OAuth Applications
OAUTH_CLIENT_ID=your_oauth_client_id

# OAuth domain (your Clerk frontend API domain)
# Usually: clerk.<your-domain>.dev
OAUTH_DOMAIN=clerk.openctl.dev

# =============================================================================
# Server Configuration (Optional)
# =============================================================================

# Server port (default: 3000)
# PORT=3000

# Server host (default: 0.0.0.0)
# HOST=0.0.0.0

# Database path (default: data/sessions.db)
# DATABASE_PATH=data/sessions.db

# Audit log file path (default: <cwd>/audit.log)
# AUDIT_LOG_PATH=/var/log/openctl/audit.log

# Node environment
# NODE_ENV=development

# =============================================================================
# CLI Version Info (Optional, set during build)
# =============================================================================

# CLI version string
# OPENCTL_VERSION=1.0.0

# Git SHA for build identification
# OPENCTL_GIT_SHA=abc123
